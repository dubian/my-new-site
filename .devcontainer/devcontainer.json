{
  "name": "Jekyll Development",
  "image": "mcr.microsoft.com/devcontainers/ruby:3.3-bookworm",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": {
      "label": "Jekyll Website",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "gem install bundler",
  "customizations": {
    "vscode": {
      "extensions": [
        "Shopify.ruby-lsp",
        "yzhang.markdown-all-in-one",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  }
}